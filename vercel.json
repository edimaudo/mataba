{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["yul1"],
  "buildCommand": "npm install --prefix frontend --include=dev && python scripts/build.py",
  "functions": {
    "app/main.py": {
      "includeFiles": "{firebase/ai_logic_templates/**,public/**}",
      "excludeFiles": "{tests/**,scripts/**,frontend/src/**,frontend/node_modules/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
