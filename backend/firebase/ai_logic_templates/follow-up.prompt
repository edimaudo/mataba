---
model: 'gemini-3.8-flash'
input:
  schema:
    prompt: string, Fully prepared and validated evidence-grounded follow-up prompt containing sanitized source excerpts
output:
  format: json
  schema:
    answer: string
    citations(array):
      sourceId: string
      excerpt: string
config:
  maxOutputTokens: 4096
---
{{role "user"}}
{{prompt}}
