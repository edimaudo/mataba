rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The current app does not upload original contract files. This owner-only
    // namespace is reserved for future sanitized exports or user-owned assets.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
