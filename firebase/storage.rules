rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The current Mataba client does not upload original contracts or
    // reference files. Listing/deleting a user's prefix is retained so the
    // account-purge workflow can remove any legacy objects. Client creates
    // and updates remain disabled until a separately reviewed sanitized-file
    // export workflow is implemented.
    match /users/{userId}/{allPaths=**} {
      allow get, list, delete: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if false;
    }
  }
}
