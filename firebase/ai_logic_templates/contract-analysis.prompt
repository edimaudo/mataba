---
model: 'gemini-3.8-flash'
input:
  schema:
    prompt: string, Fully prepared and validated contract-analysis prompt containing sanitized contract and reference text
output:
  format: json
  schema:
    executiveSummary: string
    executiveSummaryCitations(array):
      sourceId: string
      excerpt: string
    findings(array):
      title: string
      category: string
      explanation: string
      practicalEffect: string
      negotiationConsideration: string
      suggestedWording: string
      citations(array):
        sourceId: string
        excerpt: string
    obligations(array):
      text: string
      citations(array):
        sourceId: string
        excerpt: string
    terminationOverview: string
    terminationCitations(array):
      sourceId: string
      excerpt: string
    lawyerReport: string
    lawyerReportCitations(array):
      sourceId: string
      excerpt: string
    hrSections(array):
      topic: string
      status: string
      analysis: string
      practicalConsiderations: string
      citations(array):
        sourceId: string
        excerpt: string
config:
  maxOutputTokens: 8192
---
{{role "user"}}
{{prompt}}
